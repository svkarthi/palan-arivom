{
  "expo": {
    "name": "பலன் அறிவோம்",
    "slug": "palan-arivom",
    "version": "1.5.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7A1F1F"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.svkarthi.palanarivom",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "வீட்டு வரைபடத்தைத் தேர்வு செய்ய புகைப்படங்கள் தேவை. / Needed to pick your floor plan image."
      }
    },
    "android": {
      "package": "com.svkarthi.palanarivom",
      "adaptiveIcon": {
        "backgroundColor": "#212244",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "திசைகாட்டி துல்லியமாக வடக்கைக் காட்ட இடம் அனுமதி தேவை. / Used to give an accurate compass heading (true north)."
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "f475bcdd-3972-45d8-a1ff-8a3517324dba"
      }
    },
    "owner": "svkarthi"
  }
}
