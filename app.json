{
  "expo": {
    "name": "Utility App",
    "slug": "utility-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.utilityapp",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "வீட்டு வரைபடத்தைத் தேர்வு செய்ய புகைப்படங்கள் தேவை. / Needed to pick your floor plan image."
      }
    },
    "android": {
      "package": "com.utilityapp",
      "adaptiveIcon": {
        "backgroundColor": "#FFF3E0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "f475bcdd-3972-45d8-a1ff-8a3517324dba"
      }
    },
    "owner": "svkarthi"
  }
}
