{
  "name": "palan-arivom",
  "version": "1.0.3",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/noto-sans-tamil": "^0.4.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@reduxjs/toolkit": "^2.13.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.19",
    "expo-print": "~58.0.7",
    "expo-sensors": "~58.0.4",
    "expo-sharing": "~58.0.20",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "i18next": "^26.5.6",
    "react": "19.3.0",
    "react-i18next": "^17.1.3",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|immer|@reduxjs/toolkit|react-redux|redux|redux-thunk|reselect|use-sync-external-store)"
    ],
    "moduleNameMapper": {
      "^@core/(.*)$": "<rootDir>/src/core/$1"
    }
  }
}
